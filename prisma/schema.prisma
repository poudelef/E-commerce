generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  description       String      @default("") @db.Text
  price             Int
  unit              String
  stock             Int         @default(0)
  lowStockThreshold Int         @default(5)
  image             String      @default("") @db.Text
  keywords          String      @default("") @db.Text
  active            Boolean     @default(true)
  categoryId        String
  category          Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems        OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([categoryId])
  @@index([active])
}

model Order {
  id              String             @id @default(cuid())
  orderNumber     String             @unique
  customerName    String
  phone           String
  email           String             @default("")
  notes           String             @default("") @db.Text
  fulfillmentType String             @default("pickup")
  pickupDate      String
  pickupSlotStart String
  pickupSlotEnd   String
  status          String             @default("new")
  subtotal        Int
  tax             Int                @default(0)
  total           Int
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           OrderItem[]
  statusEvents    OrderStatusEvent[]
  edits           OrderEdit[]

  @@index([status])
  @@index([pickupDate])
  @@index([createdAt])
  @@index([phone])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  name        String
  unit        String
  unitPrice   Int
  quantity    Int
  unavailable Boolean  @default(false)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String   @default("") @db.Text
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderEdit {
  id        String   @id @default(cuid())
  orderId   String
  message   String   @db.Text
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model StoreSettings {
  id              String   @id @default("default")
  storeName       String
  address         String   @db.Text
  phone           String
  email           String
  hoursJson       String   @db.Text
  leadTimeMinutes Int      @default(120)
  slotMinutes     Int      @default(30)
  taxEnabled      Boolean  @default(false)
  taxBps          Int      @default(0)
  timezone        String   @default("Asia/Kathmandu")
  orderCounter    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
